{
  "expo": {
    "name": "AssistantLivingApp",
    "slug": "AssistantLivingApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSMicrophoneUsageDescription": "This app uses the microphone to recognize your voice commands."
      }
    },
    "android": {
      "googleServicesFile": "./android/app/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ibrahim_1.AssistantLivingApp"
    },
  "plugins": [
  "expo-notifications",
  [
    "expo-notifications",
    {
      "sounds": [
        "./assets/sounds/emergency.mp3",
        "./assets/sounds/nomovement.mp3",
        "./assets/sounds/takemedication.mp3",
        "./assets/sounds/takenmedication.mp3",
        "./assets/sounds/unusualmovement.mp3",
        "./assets/sounds/unusualsleep.mp3",
        "./assets/sounds/upcomingmedication.mp3"
      ],
      "enableBackgroundRemoteNotifications": true,
      "icon": "./assets/favicon.png"
    }
  ]
]
,
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "531d95c5-30bc-43ab-8c12-793765e0230a"
      }
    }
  }
}
